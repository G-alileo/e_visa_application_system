# Copy this file to .env and fill in the values. Never commit .env to version control.

# Django Core
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL Database
DB_NAME=evisa_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Chatbot LLM and Embedding Configuration
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHATBOT_KNOWLEDGEBASE_PATH=apps/chatbot/document_processing/knowledgebase.MD
CHROMA_DB_PATH=apps/chatbot/vector_database/chroma_store
CHATBOT_TOP_K=4
CHATBOT_TEMPERATURE=0.2
